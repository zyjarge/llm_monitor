# =============================================================================
# LLM Monitor — environment configuration
# Copy to .env and fill in the values.
# =============================================================================

# ─── Provider 开关 ─────────────────────────────────────────────────
# 设为 false 可以完全停掉某个 provider：不发请求、不启动浏览器、不产生
# Telegram 失败告警。适合上游已经改版（比如 opencode_go 的 SELECTORS 过期）
# 或者你暂时不关心某个平台的时候。
MINIMAXI_ENABLED=true
OPENCODE_GO_ENABLED=false
KIMI_CODE_ENABLED=true

# ─── MiniMax 中国区 (官方 API，长期有效) ─────────────────────────────
# 在 https://platform.minimaxi.com/user-center/basic-information/interface-key 创建
MINIMAX_API_KEY=*** endpoint (默认无需改)
MINIMAX_API_URL=https://www.minimaxi.com/v1/api/openplatform/coding_plan/remains

# ─── OpenCode Go (cookie 文件路径) ────────────────────────────────
# 控制台 URL: https://opencode.ai/workspace/{ID}/go
OPENCODE_GO_WORKSPACE_ID=
# cookie 文件：原始 'Cookie:' header 串（name=value; name2=value2...）
# 文件不存在或缺少 auth cookie → is_configured() 返回 False，scraper 自动跳过
OPENCODE_GO_COOKIE_FILE=cookie/opencode_cookie

# ─── Kimi Code (api.kimi.com/coding/v1/usages) ──────────────────
# Auth: API key (NOT cookie-based anymore). Get it from
# https://www.kimi.com/code → API Keys. The same key works for the CLI /
# Claude Code / Roo Code integrations, and queries the same Kimi Code
# platform quota that the `/usage` CLI command shows (5h rate window +
# weekly request quota).
KIMI_API_URL=https://api.kimi.com/coding/v1/usages
KIMI_API_KEY=***

# ─── Kimi 月度余额（可选，需要网页 session） ─────────────────────────
# 月度余额（console 上显示的那个数）来自 Kimi 会员接口
# MembershipService/GetSubscriptionStats，需要 www.kimi.com 的登录态
# （web token，Netscape 格式导出或 access_token）。
#
# ⚠️ 月度余额只有这个接口有。Code API 里没有"月度余额"这个字段 ——
#    它的 usage/limits 是请求数池，usages.limit_* 是这些池的比例。
#    所以没有 token 时，月度余额窗口就是空的（指标 -1），不会拿别的数来凑。
#
# 没有 token 也能工作：加速包花费（booster_wallet）和请求数池照常上报。
#
# ⚠️ 新版 Kimi 网页不再写 `kimi-auth` cookie 了，JWT 存在 localStorage 的
# `access_token` 里，Cookie-Editor 导出的 cookie 里没有它。
#
# 拿 token 的四种方式（优先级从高到低）：
#   A. python scripts/kimi_qr_login.py
#      → 终端打印二维码，用 Kimi App 扫一下即可。
#        不需要浏览器 profile、不需要 DevTools、不需要导出 cookie。
#   B. python scripts/fetch_kimi_token.py --profile <chrome profile>
#      → 从已登录的浏览器 localStorage 里读
#   C. 手动：F12 → Application → Local Storage → www.kimi.com →
#      复制 access_token 的值，存到 cookie/kimi_token（一行，不要引号）
#   D. 直接填下面的 KIMI_AUTH_TOKEN
KIMI_COOKIE_FILE=cookie/kimi_cookie
KIMI_TOKEN_FILE=cookie/kimi_token
# The access token lives ~15 minutes; the refresh token (from the same login)
# is valid for months and is exchanged automatically. Written by
# `python scripts/kimi_qr_login.py` alongside the access token.
KIMI_REFRESH_TOKEN_FILE=cookie/kimi_refresh_token
KIMI_AUTH_TOKEN=

# ─── Telegram 告警 ────────────────────────────────────────────────────────
# @BotFather → /newbot → 拿到 token
TELEGRAM_BOT_TOKEN=*** → 给你的机器人发任意消息 → 访问
#   https://api.telegram.org/bot<TOKEN>/getUpdates → 取 chat.id
TELEGRAM_CHAT_ID=*** ─── 运行参数 ────────────────────────────────────────────────
PUSHGATEWAY_URL=http://pushgateway:9091
SCRAPE_INTERVAL=300          # 秒，默认 5 分钟
HISTORY_RETENTION_DAYS=30    # SQLite 历史保留天数

ALERT_WARNING_THRESHOLD=80
ALERT_CRITICAL_THRESHOLD=95

# Cookie 失效容忍：连续失败多少次后告警 (Telegram)
COOKIE_FAILURE_TOLERANCE=3

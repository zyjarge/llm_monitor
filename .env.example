# =============================================================================
# LLM Monitor — environment configuration
# Copy to .env and fill in the values.
# =============================================================================

# ─── MiniMax 中国区 (官方 API，长期有效) ─────────────────────────────
# 在 https://platform.minimaxi.com/user-center/basic-information/interface-key 创建
MINIMAX_API_KEY=*** endpoint (默认无需改)
MINIMAX_API_URL=https://www.minimaxi.com/v1/api/openplatform/coding_plan/remains

# ─── OpenCode Go (cookie 文件路径) ────────────────────────────────
# 控制台 URL: https://opencode.ai/workspace/{ID}/go
OPENCODE_GO_WORKSPACE_ID=
# cookie 文件：原始 'Cookie:' header 串（name=value; name2=value2...）
# 文件不存在或缺少 auth cookie → is_configured() 返回 False，scraper 自动跳过
OPENCODE_GO_COOKIE_FILE=cookie/opencode_cookie

# ─── Kimi Code (api.kimi.com/coding/v1/usages) ──────────────────
# Auth: API key (NOT cookie-based anymore). Get it from
# https://www.kimi.com/code → API Keys. The same key works for the CLI /
# Claude Code / Roo Code integrations, and queries the same Kimi Code
# platform quota that the `/usage` CLI command shows (5h rate window +
# weekly request quota).
KIMI_API_URL=https://api.kimi.com/coding/v1/usages
KIMI_API_KEY=***

# ─── Telegram 告警 ────────────────────────────────────────────────────────
# @BotFather → /newbot → 拿到 token
TELEGRAM_BOT_TOKEN=*** → 给你的机器人发任意消息 → 访问
#   https://api.telegram.org/bot<TOKEN>/getUpdates → 取 chat.id
TELEGRAM_CHAT_ID=*** ─── 运行参数 ────────────────────────────────────────────────
PUSHGATEWAY_URL=http://pushgateway:9091
SCRAPE_INTERVAL=300          # 秒，默认 5 分钟
HISTORY_RETENTION_DAYS=30    # SQLite 历史保留天数

ALERT_WARNING_THRESHOLD=80
ALERT_CRITICAL_THRESHOLD=95

# Cookie 失效容忍：连续失败多少次后告警 (Telegram)
COOKIE_FAILURE_TOLERANCE=3

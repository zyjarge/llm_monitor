{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Unified LLM quota monitor — MiniMax CN, OpenCode Go, Kimi Code",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Quota Usage % (5h / Weekly / Monthly)",
      "type": "bargauge",
      "datasource": "Prometheus",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "llm_quota_percent{instance=~\".+\"} >= 0",
          "legendFormat": "{{provider}} · {{window}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "minVizWidth": 0,
        "minVizHeight": 16
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 80},
              {"color": "red",    "value": 95}
            ]
          },
          "mappings": [],
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "title": "Trend — Last 6 Hours",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "llm_quota_percent{instance=~\".+\"} >= 0",
          "legendFormat": "{{provider}} {{window}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10},
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "title": "Quota Status (1=OK, 0=ERROR)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 12},
      "targets": [
        {
          "expr": "llm_scraper_status",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",   "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "OK", "color": "green"}}}
          ]
        }
      }
    },
    {
      "title": "Reset Countdown (5h window)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 21},
      "targets": [
        {
          "expr": "llm_quota_reset_seconds{window=\"5h\"} / 60",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 30},
              {"color": "red",    "value": 10}
            ]
          }
        }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["llm", "quota"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "LLM Quota Monitor",
  "uid": "llm-quota-monitor",
  "version": 1
}
